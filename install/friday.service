[Unit]
Description=FRIDAY AI OS Background Daemon
Documentation=https://github.com/anomalyco/opencode
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=__USER__
ExecStart=__FRIDAY_DIR__/.venv/bin/python __FRIDAY_DIR__/friday/main.py --daemon
WorkingDirectory=__FRIDAY_DIR__
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
