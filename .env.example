# FRIDAY Environment Configuration
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# OpenRouter (cloud inference routing)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenCode Zen (free tier, works out of box)
# Get key at: https://opencode.ai
OPENCODE_ZEN_API_KEY=sk-zen-your-key-here

# Ollama (local inference)
OLLAMA_URL=http://127.0.0.1:11434

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/friday.db

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
